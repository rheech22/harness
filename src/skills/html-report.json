  "assets": [
    "assets/report/report-shell.html",
    "assets/report/code-review-report.html.template",
    "assets/report/explanation-quiz.html.template",
    "assets/report/report-diagram-flow.html.template",
    "assets/report/report-diagram-structure.html.template",
    "assets/report/report-diagram-compare.html.template",
    "assets/report/report-shell-lucide-license.txt",
    "assets/report/report-prose-im-not-ai-license.txt"
  ],
  "scripts": [
    "assets/report/scripts/check-explanation-report.mjs",
    "assets/report/scripts/check-report-diagrams.mjs"
  ],
  "profile": {
    "name": "html-report",
    "default": "docs/common/profiles/html-report.default.md",
