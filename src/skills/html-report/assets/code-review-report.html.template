<!-- 코드 리뷰 report body

이 파일은 자립형 HTML이 아니라 `report-shell.html`의 세 구간에 넣는 조각입니다.
shell을 복사한 뒤 BODY_STYLE, BODY, BODY_SCRIPT 구간을 각각 아래 내용으로 바꿉니다.
shell 구간의 CSS와 스크립트는 고치지 않습니다. 규칙과 이유는
`report-design.md`, 조립과 검증 절차는 `html-report.md`를 따릅니다.

표제는 shell의 header가 담당합니다. KICKER는 `Code Review`, HEADING은 리뷰 대상을
한 줄로 설명하는 제목입니다. 표제 아래 메타 행은 생략하고 검토 범위는 검증 기록에 둡니다.
-->

<!-- ===== BODY_STYLE ===== -->

/* ── 탭 ───────────────────────────────── */
.tabs{display:flex;justify-content:center;gap:1.75rem;margin:0;flex-wrap:wrap}
.tab{appearance:none;background:none;border:0;padding:.3rem 0;cursor:pointer;color:var(--faint);
     border-bottom:1px solid transparent;transition:color .12s}
.tab:hover{color:var(--muted)}
.tab[aria-selected="true"]{color:var(--ink);border-bottom-color:var(--accent)}
.tab .c{margin-left:.5em;color:var(--faint)}
.tab[aria-selected="true"] .c{color:var(--accent)}

/* ── 지적 사항 ─────────────────────────────── */
.f{margin-top:4.5rem}
.f-meta{margin:0;display:flex;flex-wrap:wrap;align-items:baseline;gap:.2rem .9rem;color:var(--faint)}
.f-meta .no{color:var(--ink)}
.f-meta .lens{color:var(--ink)}
.f-meta .k{color:var(--faint)}
.sev{display:inline}
.sev[data-l="high"]{color:var(--accent)}
.sev[data-l="mid"]{color:var(--ink)}
.sev[data-l="low"]{color:var(--muted)}
.review-tabs[hidden]{display:none}
.review-panel[hidden]{display:none}
@media print{
  .review-tabs{display:none}
  .review-panel[hidden]{display:block}
}
.f h2{margin:.7rem 0 0;font-size:18px;font-weight:600;line-height:1.6;letter-spacing:-.012em}
.f .loc{margin:.35rem 0 0}
.part{margin-top:2.25rem}
.part h3{margin:0 0 1rem;font-size:16px;font-weight:600;line-height:1.6}
.part p:last-child{margin-bottom:0}
.opt{margin-top:1.75rem}
.opt:first-of-type{margin-top:0}
.opt-h{margin:0 0 .5rem;font-weight:600;font-size:14px;letter-spacing:-.01em}
.opt-h .mark{color:var(--accent);margin-right:.5em;
  font-family:ui-monospace,Menlo,monospace;font-size:11px;letter-spacing:.08em}
.trade{margin:.9rem 0 0;display:grid;grid-template-columns:auto 1fr;gap:.15rem 1rem;font-size:13px}
.trade dt{margin:0;color:var(--faint);white-space:nowrap;padding-top:.35em}
.trade dd{margin:0;color:var(--muted);line-height:1.75}
/* 어느 안을 권하는지 한 줄로 밝힙니다. 트레이드오프 목록과 섞이지 않게 라벨을 답니다. */
.pick{display:flex;gap:.9rem;align-items:baseline;margin:1.75rem 0 0}
.pick .lbl{flex:none;margin:0;color:var(--ink)}
.pick p{margin:0}

/* ── 꼬리 ─────────────────────────────── */
.tail{margin-top:5rem}
.tail h2{margin:0 0 1rem;font-size:18px;font-weight:600;letter-spacing:-.01em}
.tail ul{margin:0;padding:0;list-style:none}
.tail li{position:relative;padding-left:1.1rem;margin-bottom:.7rem;color:var(--muted)}
.tail li::before{content:"·";position:absolute;left:.25rem;color:var(--faint)}
.tail p{margin:0 0 .9rem;color:var(--muted)}
.tail p.lbl{margin:2rem 0 .6rem}


/* ── 검증 기록 ─────────────────────────── */
.record-stack{max-width:42rem;margin:3rem auto 0;overflow-wrap:anywhere}
.record-section + .record-section{margin-top:2.5rem;padding-top:2rem;border-top:1px solid var(--hair)}
.record-section h2{margin:0 0 1rem;font-size:18px;font-weight:600}
.record-section h3{margin:0 0 .4rem;font-size:16px;font-weight:600}
.record-section p{margin:.4rem 0 0}
.record-scope{display:grid;grid-template-columns:5rem minmax(0,1fr);gap:.5rem 1rem;margin:0}
.record-scope dt{color:var(--muted)}
.record-scope dd{margin:0}
.record-note{color:var(--muted);font-size:14px}
.check-list{list-style:none;margin:0;padding:0}
.check-row{display:grid;grid-template-columns:4.5rem minmax(0,1fr);gap:1rem;padding:1rem 0;border-top:1px solid var(--hair)}
.check-row:first-child{border-top:0;padding-top:0}
.check-state{font-size:13px;font-weight:600;align-self:start;padding:.15rem .4rem;text-align:center;border:1px solid var(--hair);border-radius:3px}
.check-row p{color:var(--muted)}
.record-section details{background:transparent;border:1px solid var(--hair)}
.record-section summary{font-weight:500}
.record-section details p{color:var(--muted)}
@media(max-width:480px){
  .check-row{grid-template-columns:1fr;gap:.65rem}
  .check-state{justify-self:start}
  .record-scope{grid-template-columns:4rem minmax(0,1fr);gap:.5rem .75rem}
}

<!-- ===== BODY ===== -->

<div class="code-review">
<nav class="tabs review-tabs" id="tabs" role="tablist" aria-label="리뷰 보고서" hidden>
  <button class="tab" id="results-tab" role="tab" type="button" aria-controls="results" aria-selected="true">리뷰 결과<span class="c">{{N_FINDINGS}}</span></button>
  <button class="tab" id="records-tab" role="tab" type="button" aria-controls="records" aria-selected="false" tabindex="-1">검증 기록</button>
</nav>
<div class="review-panel" id="results" role="tabpanel" aria-labelledby="results-tab" tabindex="0">
<div id="findings">
  <!-- 중요도 high, mid, low 순으로 article을 반복합니다. 고정 ID는 화면 번호로 노출하지 않습니다.
       지적이 없으면 article 대신 검증된 지적이 없다는 문장 하나를 둡니다. -->
  <article class="f wide" id="{{FINDING_ID}}" data-sev="high">
    <p class="f-meta"><span class="sev" data-l="high">높음</span></p>
    <h2>{{TITLE}}</h2>
    <p class="loc path"><a href="{{FILE_URL}}">{{SHORT_FILE}}:{{LINE}}</a></p>
    <div class="part">
      <h3>문제</h3>
      <p>{{어떤 조건에서 무엇이 잘못되며 어떤 영향이 있는지}}</p>
      <p>{{판단에 꼭 필요한 근거 요약과 한계. 해당하지 않으면 생략}}</p>
    </div>
    <div class="part">
      <h3>제안</h3>
      <p>{{권장 수정 방향과 필요한 결정. 짧고 구체적으로}}</p>
      <!-- 복수 제안의 비교가 필요할 때만 표를 남깁니다. 같은 내용을 본문에 반복하지 않습니다. -->
      <table class="tbl">
        <caption>제안별 조건과 영향</caption>
        <thead><tr><th scope="col">제안</th><th scope="col">조건</th><th scope="col">이점</th><th scope="col">비용</th></tr></thead>
        <tbody><tr><th scope="row">{{제안 이름}}</th><td>{{조건}}</td><td>{{이점}}</td><td>{{비용}}</td></tr></tbody>
      </table>
    </div>
    <details>
      <summary>코드·재현 근거</summary>
      <p>{{FINDING_ID}} · {{LENS}}</p>
      <figure class="code">
        <figcaption class="path">{{FILE}}:{{LINE_RANGE}}</figcaption>
<pre data-hl="{{HL_LINES}}"><code class="language-tsx">{{ESCAPED_CODE}}</code></pre>
      </figure>
      <p>{{반례·실패 시나리오·규칙 링크. 제안 코드가 필요하면 여기에서 구분해 표시}}</p>
      <!-- 실제 측정 출력이 있을 때만 둡니다. -->
      <pre class="out">{{COMMAND_AND_OUTPUT}}</pre>
    </details>
  </article>
</div>
<!-- 결정이 필요한 경우만 남깁니다. 확정 지적 개수에는 넣지 않습니다. -->
<section class="tail col">
  <h2>결정 필요 사항</h2>
  <p>{{선택지·영향·필요한 답. 관련 지적은 문제 제목으로 연결}}</p>
</section>
</div>
<div class="review-panel" id="records" role="tabpanel" aria-labelledby="records-tab" tabindex="0">
<div class="record-stack">
<section class="record-section">
  <h2>검토 범위</h2>
  <dl class="record-scope">
    <dt>대상</dt><dd>{{브랜치 · 짧은 revision 범위}}</dd>
    <dt>규모</dt><dd>{{커밋 수 · 파일 수}}</dd>
    <dt>검토일</dt><dd>{{YYYY-MM-DD}}</dd>
  </dl>
</section>
<section class="record-section">
  <h2>검증 결과</h2>
  <!-- 검사별로 반복합니다. 상태는 확인·실패·미실행 등 실제 결과에 맞게 쓰고 색에 의존하지 않습니다. -->
  <ul class="check-list">
    <li class="check-row"><span class="check-state">{{상태}}</span><div>
      <h3>{{검사 이름}}</h3><p>{{확인한 결과와 판단 범위}}</p>
    </div></li>
    <!-- 미확인 범위는 접지 않습니다. 필요한 다음 검사는 해당 항목 안에만 적습니다. -->
    <li class="check-row"><span class="check-state">미실행</span><div>
      <h3>{{확인하지 못한 환경·검사}}</h3><p>{{한계와 필요한 다음 검사}}</p>
    </div></li>
  </ul>
</section>
<!-- 해당 내용이 있을 때만 아래 절을 남깁니다. -->
<section class="record-section">
  <h2>확인 후 제외한 항목</h2>
  <details><summary>{{후보 이름 · 제외 결론}}</summary><p>{{구체적인 제외 근거}}</p></details>
</section>
<section class="record-section">
  <h2>검토 관점</h2>
  <p>{{analytics 대조 결론과 미확인 범위}}</p>
  <details><summary>Analytics 경로 대조</summary><p>{{경로·이벤트 대조 근거}}</p></details>
  <details><summary>적용한 관점과 제외 이유</summary><p>{{검토한 관점과 적용하지 않은 관점의 이유}}</p></details>
</section>
</div>
</div>
</div>

<!-- ===== BODY_SCRIPT ===== -->
<script>
(function () {
  var nav = document.querySelector(".review-tabs");
  var tabs = Array.from(nav.querySelectorAll('[role="tab"]'));
  function select(tab) {
    tabs.forEach(function (item) {
      var active = item === tab;
      item.setAttribute("aria-selected", String(active));
      item.tabIndex = active ? 0 : -1;
      document.getElementById(item.getAttribute("aria-controls")).hidden = !active;
    });
  }
  tabs.forEach(function (tab, index) {
    tab.addEventListener("click", function () { select(tab); });
    tab.addEventListener("keydown", function (event) {
      var next;
      if (event.key === "ArrowRight") next = (index + 1) % tabs.length;
      else if (event.key === "ArrowLeft") next = (index + tabs.length - 1) % tabs.length;
      else if (event.key === "Home") next = 0;
      else if (event.key === "End") next = tabs.length - 1;
      else return;
      event.preventDefault();
      select(tabs[next]);
      tabs[next].focus();
    });
  });
  nav.hidden = false;
  select(tabs[0]);
  function revealHash() {
    var id;
    try { id = decodeURIComponent(location.hash.slice(1)); } catch (_) { return; }
    var target = document.getElementById(id);
    if (!target) return;
    var panel = target.closest(".review-panel");
    var tab = tabs.find(function (item) { return item.getAttribute("aria-controls") === (panel && panel.id); });
    if (tab) { select(tab); target.scrollIntoView(); }
  }
  window.addEventListener("hashchange", revealHash);
  revealHash();
})();
</script>
