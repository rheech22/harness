{
  "runtime": "claude",
  "targets": {
    "instructions": "~/.claude/CLAUDE.md",
    "skills": "~/.claude/skills",
    "rules": "~/.claude/rules",
    "commands": "~/.claude/commands",
    "settings": "~/.claude/settings.json"
  },
  "links": [
    {
      "src": "@root/AGENTS.md",
      "to": [
        "instructions"
      ]
    },
    {
      "src": "@shared.skills/*",
      "to": [
        "skills"
      ],
      "mode": "per-entry"
    },
    {
      "src": "@dist/adapters/claude/commands/*",
      "to": [
        "commands"
      ],
      "mode": "per-entry"
    },
    {
      "src": "@dist/adapters/claude/rules/*",
      "to": [
        "rules"
      ],
      "mode": "per-entry"
    }
  ],
  "project": "project",
  "configure": {
    "source": "settings.json",
    "target": "settings",
    "state": "~/.local/state/harness/claude-settings.json"
  }
}
