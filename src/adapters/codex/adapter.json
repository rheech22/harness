{
  "runtime": "codex",
  "targets": {
    "instructions": "~/.codex/AGENTS.md",
    "rules": "~/.codex/rules",
    "hooks": "~/.codex/hooks.json"
  },
  "links": [
    {
      "src": "@root/AGENTS.md",
      "to": [
        "instructions"
      ]
    },
    {
      "src": "rules/*",
      "to": [
        "rules"
      ],
      "mode": "per-entry"
    }
  ],
  "project": "project",
  "configure": {
    "source": "hooks.json",
    "target": "hooks",
    "state": "~/.local/state/harness/codex-settings.json"
  }
}
