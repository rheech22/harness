{
  "version": 1,
  "targets": {
    "shared": {
      "skills": "~/.agents/skills"
    }
  },
  "links": [
    {
      "src": "dist/skills/*",
      "to": [
        "shared.skills"
      ],
      "mode": "per-entry",
      "profiles": true
    }
  ],
  "profiles": {
    "common": [
      "code-review",
      "harness-maintainer",
      "docs-writing",
      "docs-review-loop",
      "git-commit",
      "coding-conventions",
      "testing-conventions",
      "git-worktrees",
      "ast-grep",
      "ast-grep-outline",
      "find-skills",
      "excalibridge"
    ],
    "writing": [
      "technical-explanation"
    ]
  },
  "external": {
    "ast-grep": "ast-grep/agent-skill",
    "ast-grep-outline": "ast-grep/agent-skill",
    "find-skills": "vercel-labs/skills",
    "excalibridge": "rheech22/excalibridge"
  },
  "publish": {
    "code-review": {
      "from": "dist/skills/code-review"
    },
    "harness-maintainer": {
      "from": "dist/skills/harness-maintainer"
    },
    "docs-writing": {
      "from": "dist/skills/docs-writing"
    },
    "docs-review-loop": {
      "from": "dist/skills/docs-review-loop"
    },
    "git-commit": {
      "from": "dist/skills/git-commit"
    },
    "coding-conventions": {
      "from": "dist/skills/coding-conventions"
    },
    "testing-conventions": {
      "from": "dist/skills/testing-conventions"
    },
    "git-worktrees": {
      "from": "dist/skills/git-worktrees"
    },
    "technical-explanation": {
      "from": "dist/skills/technical-explanation"
    }
  },
  "tools": {
    "excalibridge": {
      "requiredBy": [
        "excalibridge"
      ],
      "install": "uv tool install 'excalibridge @ git+https://github.com/rheech22/excalibridge@v0.7.0'",
      "check": "excalibridge --version"
    },
    "ast-grep": {
      "requiredBy": [
        "ast-grep",
        "ast-grep-outline"
      ],
      "install": "brew install ast-grep",
      "check": "ast-grep --version"
    },
    "rg": {
      "requiredBy": [
        "*"
      ],
      "install": "brew install ripgrep",
      "check": "rg --version"
    },
    "jq": {
      "requiredBy": [
        "*"
      ],
      "install": "brew install jq",
      "check": "jq --version"
    }
  },
  "adapters": "src/adapters",
  "templates": "src/templates/project"
}
