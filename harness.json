{
  "version": 1,
  "targets": {
    "shared": {
      "skills": "~/.agents/skills"
    }
  },
  "links": [
    {
      "src": "dist/skills/*",
      "to": [
        "shared.skills"
      ],
      "mode": "per-entry",
      "profiles": true
    }
  ],
  "profiles": {
    "common": [
      "code-review",
      "html-report",
      "harness-maintainer",
      "docs-writing",
      "docs-review-loop",
      "git-commit",
      "coding-conventions",
      "testing-conventions",
      "git-worktrees",
      "ast-grep",
      "ast-grep-outline",
      "find-skills",
      "excalibridge"
    ],
    "writing": [
      "explain"
    ],
    "web": [
      "fsd-architecture",
      "web-ui-conventions",
      "storybook-conventions",
      "web-accessibility"
    ]
  },
  "external": {
    "ast-grep": "ast-grep/agent-skill",
    "ast-grep-outline": "ast-grep/agent-skill",
    "find-skills": "vercel-labs/skills"
  },
  "publish": {
    "code-review": {
      "from": "dist/skills/code-review"
    },
    "html-report": {
      "from": "dist/skills/html-report"
    },
    "harness-maintainer": {
      "from": "dist/skills/harness-maintainer"
    },
    "docs-writing": {
      "from": "dist/skills/docs-writing"
    },
    "docs-review-loop": {
      "from": "dist/skills/docs-review-loop"
    },
    "git-commit": {
      "from": "dist/skills/git-commit"
    },
    "coding-conventions": {
      "from": "dist/skills/coding-conventions"
    },
    "testing-conventions": {
      "from": "dist/skills/testing-conventions"
    },
    "git-worktrees": {
      "from": "dist/skills/git-worktrees"
    },
    "explain": {
      "from": "dist/skills/explain"
    },
    "fsd-architecture": {
      "from": "dist/skills/fsd-architecture"
    },
    "web-ui-conventions": {
      "from": "dist/skills/web-ui-conventions"
    },
    "storybook-conventions": {
      "from": "dist/skills/storybook-conventions"
    },
    "web-accessibility": {
      "from": "dist/skills/web-accessibility"
    },
    "excalibridge": {
      "from": "src/packages/excalibridge",
      "versionFile": "excalibridge/__init__.py",
      "strip": [
        ".gitignore",
        "tests/**",
        "**/__pycache__/**",
        "**/*.pyc",
        ".venv/**",
        "dist/**",
        "build/**",
        "*.egg-info/**"
      ]
    }
  },
  "tools": {
    "excalibridge": {
      "requiredBy": [
        "excalibridge"
      ],
      "install": "uv tool install 'excalibridge @ git+https://github.com/rheech22/harness@excalibridge-v0.7.1#subdirectory=dist/packages/excalibridge'",
      "check": "excalibridge --version"
    },
    "ast-grep": {
      "requiredBy": [
        "ast-grep",
        "ast-grep-outline"
      ],
      "install": "brew install ast-grep",
      "check": "ast-grep --version"
    },
    "rg": {
      "requiredBy": [
        "*"
      ],
      "install": "brew install ripgrep",
      "check": "rg --version"
    },
    "jq": {
      "requiredBy": [
        "*"
      ],
      "install": "brew install jq",
      "check": "jq --version"
    }
  },
  "adapters": "src/adapters",
  "templates": "src/templates/project"
}
